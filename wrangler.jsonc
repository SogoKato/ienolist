{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "okatte",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // The web app (pnpm build) is served as static assets; everything the server answers itself goes to the Worker.
  "build": { "command": "pnpm build" },
  "assets": {
    "directory": "dist/web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/oauth/*", "/mcp", "/mcp/*", "/.well-known/*"]
  },
  // Created on first deploy if no id is given. The Worker applies the SQL in drizzle/ itself on its first
  // request, recording it where `wrangler d1 migrations apply` does, so that command is optional.
  "d1_databases": [
    { "binding": "DB", "database_name": "okatte", "migrations_dir": "drizzle" }
  ]
  // Set PUBLIC_URL (and optionally APP_NAME, SETUP_TOKEN, OAUTH_CLIENTS) as vars or secrets;
  // for local development put them in .dev.vars, e.g. PUBLIC_URL=http://localhost:8787
}
