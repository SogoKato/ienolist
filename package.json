{
  "name": "okatte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "gen": "node scripts/gen-tools.ts && node scripts/gen-migrations.ts",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit && tsc -p e2e --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "start": "node src/node.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "e2e": "node scripts/e2e.ts",
    "build": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "packageManager": "pnpm@10.13.1",
  "cloudflare": {
    "bindings": {
      "SETUP_TOKEN": {
        "description": "最初の管理者を作るときに入力する合言葉。長めの文字列にしてください。これがないと、URL を最初に開いた人が誰でも管理者になれます。"
      }
    }
  }
}
